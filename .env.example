# MazadPay API — Environment Variables
# Copy to .env for local development. NEVER commit .env to Git.

# ── Server ────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
APP_VERSION=0.1.0

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://mazadpay.com,https://www.mazadpay.com,https://admin.mazadpay.com

# ── Database (Neon PostgreSQL) ────────────────────────────────
# sslmode=require is mandatory for Neon.
# Leave empty to run without database (development only).
DATABASE_URL=postgresql://user:password@host:5432/mazadpay?sslmode=require

# ── Database pool ────────────────────────────────────────────
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h

# ── JWT (Milestone 3) ─────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# ── Cloudflare R2 (Milestone 6) ───────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mazadpay-media
R2_PUBLIC_URL=https://media.mazadpay.com
